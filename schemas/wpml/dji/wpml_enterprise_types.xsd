<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.dji.com/wpmz/1.0.2"
           xmlns="http://www.dji.com/wpmz/1.0.2"
           elementFormDefault="qualified">

  <!-- Document Metadata -->
  <xs:element name="author" type="xs:string"/>
  <xs:element name="createTime" type="xs:unsignedLong"/>
  <xs:element name="updateTime" type="xs:unsignedLong"/>

  <!-- Enterprise Drone Enums (77: Mavic 3E, 67: M30/30T, 60: M300/350, 71: Inspire 3, etc.) -->
  <xs:simpleType name="EnterpriseDroneEnumType">
    <xs:restriction base="xs:integer">
      <xs:enumeration value="77"/>
      <xs:enumeration value="67"/>
      <xs:enumeration value="60"/>
      <xs:enumeration value="71"/>
      <xs:enumeration value="61"/>
      <xs:enumeration value="66"/>
      <xs:enumeration value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Mission Configuration -->
  <xs:element name="missionConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="flyToWaylineMode" type="xs:string"/>
        <xs:element name="finishAction" type="xs:string"/>
        <xs:element name="exitOnRCLost" type="xs:string"/>
        <xs:element name="executeRCLostAction" type="xs:string"/>
        <xs:element name="takeOffSecurityHeight" type="xs:decimal"/>
        <xs:element name="globalTransitionalSpeed" type="xs:decimal"/>
        <xs:element name="droneInfo">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="droneEnumValue" type="EnterpriseDroneEnumType"/>
              <xs:element name="droneSubEnumValue" type="xs:integer" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="payloadInfo" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="payloadEnumValue" type="xs:integer" minOccurs="0"/>
              <xs:element name="payloadSubEnumValue" type="xs:integer" minOccurs="0"/>
              <xs:element ref="payloadPositionIndex" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Folder elements -->
  <xs:element name="templateType" type="xs:string"/>
  <xs:element name="templateId" type="xs:integer"/>
  <xs:element name="executeHeightMode" type="xs:string"/>
  <xs:element name="waylineId" type="xs:integer"/>
  <xs:element name="distance" type="xs:decimal"/>
  <xs:element name="duration" type="xs:decimal"/>
  <xs:element name="autoFlightSpeed" type="xs:decimal"/>

  <xs:element name="payloadPositionIndex" type="xs:integer"/>
  <xs:element name="payloadPitchControlMode" type="xs:string"/>

  <xs:element name="payloadParam">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="payloadPositionIndex"/>
        <xs:element ref="payloadPitchControlMode"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Waypoint elements -->
  <xs:element name="index" type="xs:integer"/>
  <xs:element name="executeHeight" type="xs:decimal"/>
  <xs:element name="waypointSpeed" type="xs:decimal"/>

  <xs:element name="waypointHeadingParam">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="waypointHeadingMode" type="xs:string"/>
        <xs:element name="waypointHeadingAngle" type="xs:decimal"/>
        <xs:element name="waypointPoiPoint" type="xs:string" minOccurs="0"/>
        <xs:element name="waypointHeadingAngleEnable" type="xs:integer"/>
        <xs:element name="waypointHeadingPathMode" type="xs:string" minOccurs="0"/>
        <xs:element name="waypointHeadingPoiIndex" type="xs:integer" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="EnterpriseTurnModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="toPointAndStopWithContinuityCurvature"/>
      <xs:enumeration value="toPointAndPassWithContinuityCurvature"/>
      <xs:enumeration value="toPointAndStopWithDiscontinuityCurvature"/>
      <xs:enumeration value="toPointAndPassWithDiscontinuityCurvature"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="waypointTurnParam">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="waypointTurnMode" type="EnterpriseTurnModeType"/>
        <xs:element name="waypointTurnDampingDist" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="useStraightLine">
    <xs:simpleType>
      <xs:restriction base="xs:integer">
        <xs:enumeration value="0"/>
        <xs:enumeration value="1"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:element>

  <!-- Action Elements -->
  <xs:element name="actionGroupId" type="xs:integer"/>
  <xs:element name="actionGroupStartIndex" type="xs:integer"/>
  <xs:element name="actionGroupEndIndex" type="xs:integer"/>
  <xs:element name="actionGroupMode" type="xs:string"/>

  <xs:element name="actionTrigger">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="actionTriggerType" type="xs:string"/>
        <xs:element name="actionTriggerParam" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="actionId" type="xs:integer"/>

  <xs:simpleType name="EnterpriseActuatorFuncType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="gimbalRotate"/>
      <xs:enumeration value="hover"/>
      <xs:enumeration value="zoom"/>
      <xs:enumeration value="takePhoto"/>
      <xs:enumeration value="startRecord"/>
      <xs:enumeration value="stopRecord"/>
      <xs:enumeration value="rotateYaw"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="actionActuatorFunc" type="EnterpriseActuatorFuncType"/>

  <xs:element name="actionActuatorFuncParam">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="payloadPositionIndex"/>
        <xs:element name="gimbalHeadingYawBase" type="xs:string"/>
        <xs:element name="gimbalRotateMode" type="xs:string"/>
        <xs:element name="gimbalPitchRotateEnable" type="xs:integer"/>
        <xs:element name="gimbalPitchRotateAngle" type="xs:decimal"/>
        <xs:element name="gimbalRollRotateEnable" type="xs:integer"/>
        <xs:element name="gimbalRollRotateAngle" type="xs:decimal"/>
        <xs:element name="gimbalYawRotateEnable" type="xs:integer"/>
        <xs:element name="gimbalYawRotateAngle" type="xs:decimal"/>
        <xs:element name="gimbalRotateTimeEnable" type="xs:integer"/>
        <xs:element name="gimbalRotateTime" type="xs:decimal"/>
        <xs:element name="hoverTime" type="xs:decimal"/>
        <xs:element name="focalLength" type="xs:decimal"/>
        <xs:element name="isUseFocalFactor" type="xs:integer"/>
        <xs:element name="focalFactor" type="xs:decimal"/>
        <xs:element name="aircraftHeading" type="xs:decimal"/>
        <xs:element name="aircraftPathMode" type="xs:string"/>
        <xs:element name="useGlobalPayloadLensIndex" type="xs:integer"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="action">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="actionId"/>
        <xs:element ref="actionActuatorFunc"/>
        <xs:element ref="actionActuatorFuncParam" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="actionGroup">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="actionGroupId"/>
        <xs:element ref="actionGroupStartIndex"/>
        <xs:element ref="actionGroupEndIndex"/>
        <xs:element ref="actionGroupMode"/>
        <xs:element ref="actionTrigger"/>
        <xs:element ref="action" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="waypointGimbalHeadingParam">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="waypointGimbalPitchAngle" type="xs:decimal"/>
        <xs:element name="waypointGimbalYawAngle" type="xs:decimal" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
